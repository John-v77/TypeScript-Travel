# ==========================================================================
# Serves the built SPA.
#
# A template rather than a finished config: Heroku assigns the port at
# runtime and nginx needs it at config time, so ${PORT} is substituted on
# container start by nginx's own docker-entrypoint envsubst step.
# ==========================================================================

server {
    listen       ${PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # gzip earns its keep here: the JS bundle is ~470 kB and mapbox-gl alone
    # is ~1.9 MB uncompressed.
    gzip             on;
    gzip_vary        on;
    gzip_min_length  1024;
    gzip_types       text/plain text/css text/javascript application/javascript application/json image/svg+xml;

    # Vite fingerprints everything under /assets, so those files are immutable
    # - a change produces a new filename. Cache them hard.
    location /assets/ {
        expires    1y;
        add_header Cache-Control "public, immutable";
        try_files  $uri =404;
    }

    # index.html must never be cached, or a returning visitor keeps loading
    # the old build's asset filenames after a deploy and gets a blank page.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Client-side routing: every unmatched path is handed to the SPA rather
    # than 404'd, so a deep link like /tour/abc123 or a refresh on
    # /myaccount/settings still loads the app.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
